# Скопируйте в .env и заполните реальными значениями тестового стенда.
# .env НИКОГДА не коммитится (см. .gitignore) — переменные ниже требуются
# tests/main-screen/non-authorized-user.spec.ts через src/services/*.
BASE_URL=
UMBRACO_CMS=

# Обязательно — пути Umbraco Delivery API вашего стенда
UMBRACO_ITEM_ENDPOINT=
UMBRACO_CONTENT_ENDPOINT=
UMBRACO_VALID_ITEM_ID=
UMBRACO_VALID_ITEM_PATH=

# Обязательно для deposit-calculator.spec.ts
# пути банковского API и реальные ID продуктов/валюты каталога вашего стенда.
DEPOSIT_CALCULATOR_ENDPOINT=
DEPOSITS_ENDPOINT=
DEPOSIT_TOP_UP_DATE_LIMITS_ENDPOINT=
DEPOSIT_PRODUCT_ID_NO_TOP_UP=
DEPOSIT_PRODUCT_ID_TERM_NO_REPLENISHMENT=
DEPOSIT_PRODUCT_ID_KYIAL=
DEPOSIT_CURRENCY_ID_KGS=
